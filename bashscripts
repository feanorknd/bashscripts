ramcheck() {
    local root_pid="${1:-}"
    local tmpfile
    local pid
    local child
    local ppid
    local command
    local comm
    local rss
    local pss
    local swappss

    local -a queue
    local -a process_list
    local -A seen
    local -A level

    if [ "$#" -ne 1 ] || ! [[ "$root_pid" =~ ^[0-9]+$ ]]; then
        printf 'Uso: ramcheck <PID>\n' >&2
        return 2
    fi

    if [ ! -d "/proc/$root_pid" ]; then
        printf 'Error: no existe el PID %s\n' "$root_pid" >&2
        return 1
    fi

    tmpfile=$(mktemp "${TMPDIR:-/tmp}/ramcheck.XXXXXX") || return 1

    queue=("$root_pid")
    level["$root_pid"]=0

    #
    # Crear el árbol completo:
    # PID raíz, hijos, nietos y demás descendientes.
    #
    while ((${#queue[@]} > 0)); do
        pid=${queue[0]}
        queue=("${queue[@]:1}")

        if [[ -n "${seen[$pid]+existe}" ]]; then
            continue
        fi

        [ -d "/proc/$pid" ] || continue

        seen["$pid"]=1
        process_list+=("$pid")

        while read -r child; do
            [[ "$child" =~ ^[0-9]+$ ]] || continue

            if [[ -z "${seen[$child]+existe}" ]]; then
                level["$child"]=$(( ${level[$pid]:-0} + 1 ))
                queue+=("$child")
            fi
        done < <(
            pgrep -P "$pid" 2>/dev/null | sort -n
        )
    done

    #
    # Leer la memoria de cada PID una sola vez.
    #
    for pid in "${process_list[@]}"; do
        [ -r "/proc/$pid/status" ] || continue

        ppid=$(
            LC_ALL=C awk '
                /^PPid:/ {
                    print $2
                    exit
                }
            ' "/proc/$pid/status" 2>/dev/null
        )

        ppid=${ppid:-0}

        if [ -r "/proc/$pid/comm" ]; then
            comm=$(<"/proc/$pid/comm")
        else
            comm="desconocido"
        fi

        command=""

        if [ -r "/proc/$pid/cmdline" ]; then
            command=$(
                tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null
            )
        fi

        command=${command% }
        command=${command//$'\t'/ }
        command=${command//$'\n'/ }

        if [ -z "$command" ]; then
            command="[$comm]"
        fi

        rss=0
        pss=0
        swappss=0

        if [ -r "/proc/$pid/smaps_rollup" ]; then
            read -r rss pss swappss < <(
                LC_ALL=C awk '
                    /^Rss:/ {
                        rss = $2
                    }

                    /^Pss:/ {
                        pss = $2
                    }

                    /^SwapPss:/ {
                        swappss = $2
                    }

                    END {
                        printf "%.0f %.0f %.0f\n",
                            rss + 0,
                            pss + 0,
                            swappss + 0
                    }
                ' "/proc/$pid/smaps_rollup" 2>/dev/null
            )

        elif [ -r "/proc/$pid/smaps" ]; then
            read -r rss pss swappss < <(
                LC_ALL=C awk '
                    /^Rss:/ {
                        rss += $2
                    }

                    /^Pss:/ {
                        pss += $2
                    }

                    /^SwapPss:/ {
                        swappss += $2
                    }

                    END {
                        printf "%.0f %.0f %.0f\n",
                            rss + 0,
                            pss + 0,
                            swappss + 0
                    }
                ' "/proc/$pid/smaps" 2>/dev/null
            )
        else
            continue
        fi

        rss=${rss:-0}
        pss=${pss:-0}
        swappss=${swappss:-0}

        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$pid" \
            "$ppid" \
            "${level[$pid]:-0}" \
            "$pss" \
            "$swappss" \
            "$rss" \
            "$command" >> "$tmpfile"
    done

    printf '\nAnálisis de memoria del PID %s\n\n' "$root_pid"

    LC_ALL=C awk -F '\t' '
        BEGIN {
            printf "%-9s %-9s %5s %12s %12s %15s  %s\n",
                "PID",
                "PPID",
                "NIVEL",
                "RAM (MB)",
                "SWAP (MB)",
                "RSS BRUTO (MB)",
                "PROCESO"

            printf "%-9s %-9s %5s %12s %12s %15s  %s\n",
                "---------",
                "---------",
                "-----",
                "------------",
                "------------",
                "---------------",
                "----------------------------------------"
        }

        {
            pid = $1 + 0
            ppid = $2 + 0
            depth = $3 + 0
            pss = $4 + 0
            swappss = $5 + 0
            rss = $6 + 0

            process = $7

            indentation = ""

            for (i = 0; i < depth; i++) {
                indentation = indentation "  "
            }

            if (depth > 0) {
                process = indentation "|- " process
            }

            printf "%-9d %-9d %5d %12.1f %12.1f %15.1f  %s\n",
                pid,
                ppid,
                depth,
                pss / 1024,
                swappss / 1024,
                rss / 1024,
                process

            process_count++
            total_pss += pss
            total_swappss += swappss
            total_rss += rss
        }

        END {
            printf "\n"
            printf "%-31s %12d\n",
                "Procesos incluidos:",
                process_count

            printf "%-31s %12.1f MB\n",
                "RAM real (PSS):",
                total_pss / 1024

            printf "%-31s %12.1f MB\n",
                "Swap real (SwapPss):",
                total_swappss / 1024

            printf "%-31s %12.1f MB\n",
                "Huella real RAM + swap:",
                (total_pss + total_swappss) / 1024

            printf "%-31s %12.1f MB\n",
                "RSS bruto sumado:",
                total_rss / 1024
        }
    ' "$tmpfile"

    printf '\n'
    printf '%s\n' \
        'RAM usa PSS y SWAP usa SwapPss.' \
        'RSS BRUTO es informativo y puede contar varias veces la memoria compartida.'

    rm -f "$tmpfile"
}


