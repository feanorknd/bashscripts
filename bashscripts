learnspam(){
        for file in $(find -maxdepth 1 -mindepth 1 -type f ! -name "dovecot*" ! -name "subscriptions"); do
                echo ""
                echo "-------------------------------------------------------------------"
                echo "Processing:"
                echo "$(realpath "$file")";
                echo ""
		if [ $(file --mime-type $file | grep "application/zstd" | wc -l) -eq 1 ]
		then
			MYCAT="/usr/bin/zstdcat"
		else
			MYCAT="/usr/bin/cat"
		fi
		${MYCAT} $file | rspamc learn_spam
	done
}

