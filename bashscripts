compare_dirs() {
  local SOURCE=""
  local NEW=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --source)
        SOURCE="${2:-}"
        shift 2
        ;;
      --new)
        NEW="${2:-}"
        shift 2
        ;;
      *)
        echo "Uso: compare_dirs --source /ruta/source --new /ruta/new"
        return 1
        ;;
    esac
  done

  [[ -z "$SOURCE" || -z "$NEW" ]] && {
    echo "Uso: compare_dirs --source /ruta/source --new /ruta/new"
    return 1
  }

  [[ ! -d "$SOURCE" ]] && {
    echo "ERROR: source no existe o no es directorio: $SOURCE"
    return 1
  }

  [[ ! -d "$NEW" ]] && {
    echo "ERROR: new no existe o no es directorio: $NEW"
    return 1
  }

  local tmp_source tmp_new
  tmp_source=$(mktemp)
  tmp_new=$(mktemp)

  trap 'rm -f "$tmp_source" "$tmp_new"' RETURN

  (
    cd "$SOURCE" || return 1
    find . -type f | sort
  ) > "$tmp_source"

  (
    cd "$NEW" || return 1
    find . -type f | sort
  ) > "$tmp_new"

  echo "Archivos solo en SOURCE:"
  comm -23 "$tmp_source" "$tmp_new"
  echo

  echo "Archivos solo en NEW:"
  comm -13 "$tmp_source" "$tmp_new"
  echo

  echo "Archivos en ambos pero distintos:"
  comm -12 "$tmp_source" "$tmp_new" | while read -r file; do
    local source_file="$SOURCE/${file#./}"
    local new_file="$NEW/${file#./}"

    local source_md5 new_md5
    source_md5=$(md5sum "$source_file" | awk '{print $1}')
    new_md5=$(md5sum "$new_file" | awk '{print $1}')

    if [[ "$source_md5" != "$new_md5" ]]; then
      echo "$file"
      echo "  SOURCE md5: $source_md5"
      echo "  NEW md5:    $new_md5"
    fi
  done
}

rastrea() {
    local archivo="$1"
    shift

    if [ -z "$archivo" ]; then echo "Uso: rastrea <archivo> [texto1] [texto2] [...]"; return 1; fi
    if [ ! -f "$archivo" ]; then echo "Error: el archivo no existe: $archivo"; return 1; fi

    local pipeline
    pipeline="tail -f \"\$archivo\""

    for filtro in "$@"; do pipeline+=" | grep -i --line-buffered -- \"\$filtro\""; done

    tail -f "$archivo" | while IFS= read -r linea; do
        local coincide=1

        for filtro in "$@"; do
            if ! grep -qi -- "$filtro" <<< "$linea"; then coincide=0; break; fi
        done

        if [ "$coincide" -eq 1 ]; then printf '%s\n' "$linea"; fi
    done
}


# RAM ANALISIS

ramlist() {
    local mode="ram"
    local limit=30
    local tmpfile
    local status
    local pid
    local name
    local ppid
    local pss
    local swappss

    case "${1:-}" in
        "")
            mode="ram"
            ;;
        --swap)
            mode="swap"
            ;;
        *)
            printf 'Uso: ramlist\n' >&2
            return 2
            ;;
    esac

    tmpfile=$(mktemp "${TMPDIR:-/tmp}/memlist.XXXXXX") || return 1

    for status in /proc/[0-9]*/status; do
        [ -r "$status" ] || continue

        pid=${status#/proc/}
        pid=${pid%/status}

        IFS=$'\t' read -r name ppid < <(
            LC_ALL=C awk '
                /^Name:/ {
                    sub(/^Name:[[:space:]]*/, "", $0)
                    gsub(/\t/, " ", $0)
                    name = $0
                }

                /^PPid:/ {
                    ppid = $2
                }

                END {
                    if (name != "") {
                        printf "%s\t%d\n", name, ppid + 0
                    }
                }
            ' "$status" 2>/dev/null
        )

        [ -n "$name" ] || continue

        ppid=${ppid:-0}
        pss=0
        swappss=0

        if [ -r "/proc/$pid/smaps_rollup" ]; then
            read -r pss swappss < <(
                LC_ALL=C awk '
                    /^Pss:/ {
                        pss = $2
                    }

                    /^SwapPss:/ {
                        swappss = $2
                    }

                    END {
                        printf "%.0f %.0f\n", pss + 0, swappss + 0
                    }
                ' "/proc/$pid/smaps_rollup" 2>/dev/null
            )

        elif [ -r "/proc/$pid/smaps" ]; then
            read -r pss swappss < <(
                LC_ALL=C awk '
                    /^Pss:/ {
                        pss += $2
                    }

                    /^SwapPss:/ {
                        swappss += $2
                    }

                    END {
                        printf "%.0f %.0f\n", pss + 0, swappss + 0
                    }
                ' "/proc/$pid/smaps" 2>/dev/null
            )
        else
            continue
        fi

        pss=${pss:-0}
        swappss=${swappss:-0}

        if (( pss + swappss > 0 )); then
            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$pid" \
                "$ppid" \
                "$name" \
                "$pss" \
                "$swappss" >> "$tmpfile"
        fi
    done

    if [ "$mode" = "ram" ]; then
        printf "%-30s %12s %12s %12s %10s\n" \
            "NOMBRE" \
            "RAM (MB)" \
            "SWAP (MB)" \
            "PADRE_PID" \
            "PROCESOS"
    else
        printf "%-30s %12s %12s %12s %10s\n" \
            "NOMBRE" \
            "SWAP (MB)" \
            "RAM (MB)" \
            "PADRE_PID" \
            "PROCESOS"
    fi

    printf "%-30s %12s %12s %12s %10s\n" \
        "------------------------------" \
        "------------" \
        "------------" \
        "------------" \
        "----------"

    LC_ALL=C awk \
        -F '\t' \
        -v mode="$mode" '
        NF >= 5 {
            pid = $1 + 0

            ppid[pid] = $2 + 0
            pname[pid] = $3
            ram[pid] = $4 + 0
            swap[pid] = $5 + 0
            present[pid] = 1
        }

        END {
            for (pid in present) {
                target_name = pname[pid]
                root = pid
                parent = ppid[root]

                while ((parent in present) && (pname[parent] == target_name)) {
                    root = parent
                    parent = ppid[root]
                }

                process_root[pid] = root
                root_members[target_name SUBSEP root]++
            }

            for (pid in present) {
                target_name = pname[pid]
                root = process_root[pid]
                root_key = target_name SUBSEP root

                if (root_members[root_key] > 1) {
                    group_pid = root
                } else if (ppid[pid] <= 1) {
                    group_pid = pid
                } else {
                    group_pid = ppid[pid]
                }

                key = target_name SUBSEP group_pid

                group_name[key] = target_name
                group_pid_value[key] = group_pid
                group_ram[key] += ram[pid]
                group_swap[key] += swap[pid]
                group_count[key]++
            }

            for (key in group_name) {
                if (mode == "ram") {
                    primary = group_ram[key]
                    secondary = group_swap[key]
                } else {
                    primary = group_swap[key]
                    secondary = group_ram[key]
                }

                if (primary <= 0) {
                    continue
                }

                printf "%.0f\t%-30.30s %12.1f %12.1f %12d %10d\n",
                    primary,
                    group_name[key],
                    primary / 1024,
                    secondary / 1024,
                    group_pid_value[key],
                    group_count[key]
            }
        }
    ' "$tmpfile" |
        sort -t $'\t' -k1,1nr |
        head -n "$limit" |
        cut -f2-

    rm -f "$tmpfile"
}


